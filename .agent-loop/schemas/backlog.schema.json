{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent loop backlog v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "phase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000,
                  "pattern": "^[A-Za-z0-9-]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000,
                  "pattern": "^https://"
                }
              },
              "required": [
                "id",
                "text",
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "allowedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "requiredChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "maxLines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "id",
          "phase",
          "requirements",
          "acceptance",
          "dependencies",
          "allowedPaths",
          "requiredChecks",
          "maxFiles",
          "maxLines"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "enabled",
    "tasks"
  ],
  "additionalProperties": false
}
