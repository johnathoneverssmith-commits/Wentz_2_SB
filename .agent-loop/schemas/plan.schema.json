{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent loop plan v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseSha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^[a-f0-9]{40}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "requirementIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000,
        "pattern": "^[A-Za-z0-9-]+$"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "addressed"
            ]
          }
        },
        "required": [
          "id",
          "resolution"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "runId",
    "manifestDigest",
    "baseSha",
    "revision",
    "requirementIds",
    "paths",
    "steps",
    "tests",
    "acceptance",
    "risks",
    "dispositions"
  ],
  "additionalProperties": false
}
