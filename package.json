{
  "name": "nfl-franchise-sim",
  "version": "0.0.0",
  "private": true,
  "description": "Fantasy-draft-based, GM-managed NFL franchise simulation game",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "server": "tsx watch server/index.ts",
    "season": "tsx src/run-season.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx src/data/players.ts data/players_sample.json",
    "validate:pool": "tsx src/data/players.ts",
    "import:madden": "tsx src/data/madden.ts",
    "generate:pool": "tsx src/data/generate-pool.ts",
    "pool:export-csv": "tsx src/data/pool-csv.ts export",
    "pool:import-csv": "tsx src/data/pool-csv.ts import",
    "analysis:audit": "node --max-old-space-size=4096 --import tsx analysis/00_schema_audit.ts",
    "online": "tsx watch --tsconfig online/tsconfig.json online/src/index.ts",
    "online:typecheck": "tsc -p online/tsconfig.json",
    "online:migrate": "tsx --tsconfig online/tsconfig.json online/src/migrate.ts",
    "online:test": "vitest run --root online"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "hyparquet": "^1.30.0",
    "hyparquet-compressors": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
