{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "."
  ],
  "exclude": [
    "fixtures/build.ts",
    "fixtures/contract-quotes.ts",
    "test-results",
    "playwright-report"
  ]
}
