{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types", "../ui-source/node_modules/@types"],
    "paths": {
      "react": ["../ui-source/node_modules/@types/react"],
      "react/*": ["../ui-source/node_modules/@types/react/*"],
      "react-dom/*": ["../ui-source/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["core", "browser", "tests", "e2e", "*.config.ts"]
}
